# Copy this file to .env and fill it in. Never commit .env.

# NVIDIA (build.nvidia.com): Lyra's brain
NVIDIA_API_KEY=
LYRA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Fish Audio: Lyra's voice
FISH_API_KEY=
FISH_VOICE_LYRA=
FISH_VOICE_NOVA=
FISH_VOICE_SOLO=
FISH_VOICE_MARCUS=
FISH_VOICE_JUNO=
# FISH_MODEL=s1

# Optional: music videos behind Lyra while songs play (YouTube Data API v3 key, free).
# Without it the background shows the song's album artwork instead.
YOUTUBE_API_KEY=
# "My music" mode: your own songs from your YouTube (music / Topic) channel. Safe for YouTube streams.
MUSIC_CHANNEL=
# Start in "channel" (your music) or "stations" (live radio)
RADIO_SOURCE=stations
# Optional: read your live stream's chat at startup (a video id or link; also settable on the page)
# YOUTUBE_LIVE_ID=
# YOUTUBE_CHAT_POLL_SEC=15

# TikTok LIVE chat, gifts and follows (unofficial tiktok-live-connector library).
# Connecting needs a signing key from eulerstream.com (keyless access was refused in testing).
# TIKTOK_SIGN_API_KEY=
# Optional: connect at startup (or type the username on the page)
# TIKTOK_USERNAME=

# Podcast voice speed (1 = Fish normal, 0.9 = a bit slower and relaxed)
# PODCAST_SPEED=0.9

# Newest episode, for on-air promos and the badge on the page (leave empty for none).
# If it's higher than LYRA_CANON_UP_TO, Lyra teases it without knowing what happens.
# LATEST_EPISODE=3
# LATEST_EPISODE_TITLE=
# LATEST_EPISODE_LINK=https://youtu.be/...

# Top-of-the-hour news (BBC RSS by default). NEWS=0 turns it off.
# NEWS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://feeds.bbci.co.uk/news/science_and_environment/rss.xml
# NEWS_SOURCE_NAME=BBC News

# Save each podcast topic to recordings/ (PODCAST_RECORD=0 turns it off)
# PODCAST_RECORD=1

# Lyra only knows episodes up to this number (spoiler guard)
LYRA_CANON_UP_TO=2
